# ── Local development only. Never commit real secrets. ──
DATABASE_URL="postgresql://portal:portal_dev_only@127.0.0.1:5433/utilization?schema=public"

# Better Auth
BETTER_AUTH_SECRET="" # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3100"

# Microsoft Entra ID (PwC tenant) — leave blank locally to use the dev sign-in
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# Comma-separated list of email domains allowed to sign in
AUTH_ALLOWED_DOMAINS="pwc.com"
# Emails granted the Admin role on first sign-in (bootstrap only)
AUTH_BOOTSTRAP_ADMINS=""

# Dev-only email/password sign-in with seeded personas. Ignored in production builds.
AUTH_DEV_LOGIN="true"

# Password for seeded dev personas (dev sign-in only)
AUTH_DEV_PASSWORD="choose-a-local-password"

# Header your ingress sets to the real client IP (used for audit + rate limits).
# Azure Front Door: x-azure-clientip. Container Apps / App Gateway: x-forwarded-for (rightmost hop is used for audit).
TRUSTED_IP_HEADER="x-real-ip"

# Role source: "true" = Entra app roles (Portal.Admin) re-synced at each sign-in; "false" = managed in the portal
AUTH_ROLES_FROM_ENTRA="false"
# "true" = only invited users (Admin > Users & roles > Add user) can sign in
AUTH_INVITE_ONLY="false"
